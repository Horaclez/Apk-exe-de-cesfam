{
  "name": "aps-master",
  "version": "1.0.0",
  "description": "APS Master - Herramienta clínica para Atención Primaria de Salud",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win"
  },
  "dependencies": {
    "@capacitor/android": "6.2.0",
    "@capacitor/core": "6.2.0"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "6.2.0",
    "electron": "33.2.0",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "cl.apsmaster.app",
    "productName": "APS Master",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "www/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.png",
      "artifactName": "APS-Master.${ext}"
    }
  }
}
