{
  "name": "aps-master-cl",
  "productName": "APS-Master CL",
  "version": "1.0.0",
  "description": "Copiloto integral de enfermería en CESFAM. Funciona sin internet.",
  "private": true,
  "main": "electron/main.js",
  "author": "APS-Master CL",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "serve": "npx serve www",
    "dist:win": "electron-builder --win portable --publish never",
    "cap:sync": "cap sync android",
    "android": "cap sync android && cap open android"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/cli": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "cl.apsmaster.app",
    "productName": "APS-Master CL",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["electron/**/*", "www/**/*", "package.json"],
    "win": { "target": ["portable"], "icon": "build/icon.png" },
    "portable": { "artifactName": "APS-Master-CL-${version}-portable.${ext}" }
  }
}
